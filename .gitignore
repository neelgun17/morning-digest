.DS_Store
worker/.wrangler/
worker/.dev.vars

# Personal data — created and maintained in the private (downstream) repo only.
# The template never carries these; gitignoring here prevents accidental seeding
# and keeps `git fetch template && git merge` clean for downstream users.
interests.md
feedback-log.md
daily/*.md
!daily/sample-digest.md

# Pipeline artifacts — SQLite is rebuilt from the event log on every run;
# ranker.pkl is a binary blob retrained nightly (train.yml force-adds it past
# this ignore). The event log IS tracked in downstream repos: the worker writes
# monthly shards under data/events/ via the GitHub Contents API and the pipeline
# appends impression records. Deliberately NOT ignored here — pipeline.yml
# stages them with a plain `git add`, which stages nothing for an ignored path.
data/digest.db
data/ranker.pkl
data/embeddings_cache/

# Eval reports — committed in the private repo per run, not in the template.
eval/metrics-*.json
eval/judge-*.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Update-check cache for the email footer (regenerated daily).
.cache/

# Local agent session state — never part of a publication.
.claude/
